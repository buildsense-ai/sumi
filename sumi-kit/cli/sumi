def cmd_shadows(a: argparse.Namespace) -> None:
    qs = f"projectId={urllib.request.quote(a.project)}"
    if a.file:
        qs += f"&fileId={urllib.request.quote(a.file)}"
    if a.mine:
        qs += "&mine=1"
    if a.all:
        qs += "&all=1"
    r = _req("GET", f"/api/shadow-docs?{qs}")
    if a.compact:
        for s in r.get("shadows", []):
            print(
                f"[{s['status']:9s}] {s['id']}  {s['fileId']}  "
                f"{(s.get('title') or '')[:50]}"
            )
    else:
        _pp(r)


def cmd_shadow_create(a: argparse.Namespace) -> None:
    content = a.content
    if a.from_file:
        with open(a.from_file, "r", encoding="utf-8") as f:
            content = f.read()
    elif content is None and not sys.stdin.isatty():
        content = sys.stdin.read()
    if content is None:
        raise SystemExit("shadow-create needs --content, --from-file, or stdin")
    body: dict = {
        "projectId": a.project,
        "fileId": a.file,
        "content": content,
    }
    if a.title:
        body["title"] = a.title
    _pp(_req("POST", "/api/shadow-docs", body))


