#!/usr/bin/env python3
"""
Sumi agent CLI — call Sumi's HTTP/WS APIs from any agent runtime.

Auth (pick one):
  export SUMI_API_KEY="cc_..."          # CatsCo ApiKey (subject auto-derived)
  export SUMI_TOKEN="eyJ..."            # session JWT

Always:
  export SUMI_BASE_URL="http://localhost:3000"
  export SUMI_WS_URL="ws://localhost:12345"   # only needed for connect

Usage:
  sumi whoami
  sumi list-projects
  sumi list-docs --project prj_x
  sumi read-doc --project prj_x --file notes/intro.md
  sumi propose-edit --project prj_x --file notes/intro.md --blocks '[...]' [--desc "..."]
  sumi list-pending --project prj_x
  sumi pending-status --project prj_x
  sumi get-onboard-prompt --project prj_x [--file notes/intro.md]
  sumi shadows --project prj_x [--file notes/intro.md] [--mine]
  sumi shadow-create --project prj_x --file notes/intro.md [--content "..."|--from-file p] [--title t]
  sumi shadow-promote --id shadow_x
  sumi shadow-discard --id shadow_x
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from typing import Any


def _env(name: str, default: str | None = None) -> str:
    v = os.environ.get(name)
    if v is not None:
        return v
    if default is not None:
        return default
    raise SystemExit(f"missing env: {name}")


def _headers() -> dict[str, str]:
    h = {"Content-Type": "application/json"}
    key = os.environ.get("SUMI_API_KEY")
    tok = os.environ.get("SUMI_TOKEN")
    if key:
        h["Authorization"] = f"Bearer {key}"
    elif tok:
        h["Authorization"] = f"Bearer {tok}"
    else:
        raise SystemExit("set SUMI_API_KEY or SUMI_TOKEN")
    return h


def _req(method: str, path: str, body: Any = None, base: str | None = None) -> dict:
    url = (base or _env("SUMI_BASE_URL", "http://localhost:3000")) + path
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, headers=_headers(), method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        body_text = e.read().decode()[:500]
        raise SystemExit(f"HTTP {e.code} {path}: {body_text}")
    except urllib.error.URLError as e:
        raise SystemExit(f"connect failed {url}: {e.reason}")


def _pp(x: Any) -> None:
    print(json.dumps(x, indent=2, ensure_ascii=False))


def cmd_whoami(_: argparse.Namespace) -> None:
    r = _req("GET", "/api/auth/me")
    _pp(r)


def cmd_list_projects(_: argparse.Namespace) -> None:
    _pp(_req("GET", "/api/projects"))


def cmd_list_docs(a: argparse.Namespace) -> None:
    _pp(_req("GET", f"/api/projects/{a.project}/documents"))


def cmd_list_members(a: argparse.Namespace) -> None:
    _pp(_req("GET", f"/api/projects/{a.project}/members"))


def cmd_read_doc(a: argparse.Namespace) -> None:
    r = _req("GET", f"/api/documents/content?projectId={a.project}&filePath={urllib.request.quote(a.file)}")
    if a.raw:
        print(r.get("content", ""))
    else:
        _pp(r)


def cmd_propose_edit(a: argparse.Namespace) -> None:
    blocks = json.loads(a.blocks)
    if not isinstance(blocks, list):
        raise SystemExit("--blocks must be a JSON array")
    body = {
        "projectId": a.project,
        "fileId": a.file,
        "blocks": blocks,
    }
    if a.desc:
        body["description"] = a.desc
    _pp(_req("POST", "/api/pending-edits", body))


def cmd_list_pending(a: argparse.Namespace) -> None:
    _pp(_req("GET", f"/api/pending-edits?projectId={a.project}"))


def cmd_pending_status(a: argparse.Namespace) -> None:
    """Summarise the review queue for this project.

    The route returns edits under `edits` and names the file `fileId`; this used
    to read `pendingEdits` / `filePath`, so it printed "0 pending" no matter how
    many edits were waiting. That is worse than an error: it reads as an empty
    queue, and nothing prompts you to look further.

    Default scope is `authored`: run from an agent's credential, the useful
    question is "did the edits I proposed land", not "is anyone reviewing me".
    """
    scope = getattr(a, "scope", None) or "authored"
    r = _req("GET", f"/api/pending-edits?projectId={a.project}&scope={scope}")
    edits = r.get("edits", [])
    pending = [e for e in edits if e.get("status") == "pending"]
    print(f"{len(pending)} pending · {len(edits)} total · scope={scope}")

    me = _req("GET", "/api/auth/me")
    mine = (me.get("actor") or {}).get("id")
    for e in pending:
        for b in e.get("blocks", []):
            author = e.get("authorId")
            who = "我" if author == mine else str(author)
            print(
                f"  {e.get('id')} {e.get('fileId','?')} "
                f"L{b.get('startLine')}-{b.get('endLine')} by {who}: "
                f"{(e.get('description') or '')[:60]}"
            )


def cmd_apply_edit(a: argparse.Namespace) -> None:
    # The route reads `editId` from the body; it can resolve the project, file
    # and blocks from the stored edit, so the id is the whole request.
    _pp(_req("POST", "/api/edits/apply", {"editId": a.id}))


def cmd_reject_edit(a: argparse.Namespace) -> None:
    # The route reads the id from the JSON body as `editId`; it ignores query
    # params, so `?id=` reached nothing.
    _pp(_req("DELETE", "/api/pending-edits", {"editId": a.id}))


def cmd_page_state(a: argparse.Namespace) -> None:
    """Aggregate pageState from all clients across the project's rooms.

    Goes through the app's own /api/page-state route, which forwards to the WS
    server's admin surface where awareness lives. Calling the WS admin endpoint
    directly (as this used to) only works when that port is reachable: behind an
    artifact gateway only the app's port is routed, and SUMI_WS_URL there is a
    WebSocket URL carrying the app path, so the request 404s.
    """
    data = _req("GET", f"/api/page-state/{urllib.request.quote(a.project)}")
    if a.compact:
        for m in data.get("members", []):
            user = (m.get("user") or {}).get("name", "?")
            kind = m.get("userKind", "?")
            state = m.get("pageState", {})
            doc = state.get("currentDocumentId", "—")
            role = state.get("role", "?")
            ai = "🤖" if state.get("aiOpen") else "·"
            fg = "👁" if state.get("foreground") else "💤"
            pending = len(state.get("activePendingEdits", []))
            print(f"{user:20} {kind:6} {doc:40} {role:8} ai={ai} fg={fg} pending={pending}")
    else:
        _pp(data)


def cmd_onboard(a: argparse.Namespace) -> None:
    """Fetch the setup prompt for this project.

    The route requires `subjectId` (an `a*` principal) because the prompt is
    written for a specific agent: it names you, states your role, and tells you
    whether you can write. Without the parameter the route answers 400, so the
    command never worked for the one audience it exists for. The caller's own
    subject is exactly what it wants, so it is read from the current credential
    rather than asked for.
    """
    me = _req("GET", "/api/auth/me")
    subject = (me.get("actor") or {}).get("id") or ""
    if not subject.startswith("a"):
        raise SystemExit(
            "get-onboard-prompt needs an agent credential (subject a*); "
            f"this one resolves to {subject or 'nothing'}"
        )

    parts = [f"subjectId={urllib.request.quote(subject)}"]
    if a.file:
        parts.append(f"fileId={urllib.request.quote(a.file)}")
    r = _req("GET", f"/api/projects/{a.project}/agent-setup?{'&'.join(parts)}")
    if a.raw:
        print(r.get("instructions", ""))
    else:
        _pp(r)


def cmd_heartbeat(a: argparse.Namespace) -> None:
    """Report whether this agent is actually present.

    Presence in Sumi is awareness: a client shows as online while it holds a
    live Yjs room connection, and disappears when it closes. A CLI cannot fake
    that by calling an HTTP endpoint — there is no heartbeat route, and inventing
    one would report liveness the editor cannot see.

    So this reports the truth instead: who the credential is, and which clients
    the server currently considers connected. With --project it also says
    whether *you* are among them, which is the question an agent asking
    "am I online?" actually has.
    """
    me = _req("GET", "/api/auth/me")
    actor = me.get("actor") or {}
    subject = actor.get("id") or ""
    out: dict[str, Any] = {
        "subject": subject,
        "kind": actor.get("kind"),
        "name": actor.get("name"),
    }

    if a.project:
        state = _req("GET", f"/api/page-state/{urllib.request.quote(a.project)}")
        members = state.get("members") or []
        sessions = [
            {
                "clientId": m.get("clientId"),
                "user": (m.get("user") or {}).get("id"),
                "kind": m.get("userKind"),
                "file": m.get("fileId"),
                "foreground": (m.get("pageState") or {}).get("foreground"),
            }
            for m in members
        ]
        out["connectedClients"] = len(sessions)
        out["sessions"] = sessions
        # Only a live room connection counts — that is what others see.
        out["present"] = any(s["user"] == subject for s in sessions)
        if not out["present"]:
            out["note"] = (
                "not present: no live room connection for this subject. "
                "Open a Yjs room (sumi connect, co-edit, or an agent-client "
                "socket) to appear online in the editor."
            )

    if a.json:
        _pp(out)
        return

    print(f"{out.get('kind')}={subject} {out.get('name') or ''}".strip())
    if a.project:
        print(f"present: {'yes' if out.get('present') else 'no'} · connected clients: {out.get('connectedClients')}")
        for s in out.get("sessions") or []:
            print(f"  {s['kind']}={s['user']} {s['file']} foreground={s['foreground']}")


def cmd_list_sessions(_: argparse.Namespace) -> None:
    """List every project with the clients currently connected to it."""
    projects = (_req("GET", "/api/projects").get("projects") or [])
    for p in projects:
        pid = p.get("id")
        if not pid:
            continue
        state = _req("GET", f"/api/page-state/{urllib.request.quote(pid)}")
        members = state.get("members") or []
        print(f"{pid} {p.get('name','')} clients={len(members)}")
        for m in members:
            user = (m.get("user") or {}).get("id")
            print(f"  {m.get('userKind')}={user} {m.get('fileId')}")


def cmd_intents(a: argparse.Namespace) -> None:
    qs = f"projectId={urllib.request.quote(a.project)}"
    if a.status:
        qs += f"&status={a.status}"
    if a.mine:
        # Get my subject id first
        me = _req("GET", "/api/auth/me")
        aid = me.get("actor", {}).get("id")
        if aid:
            qs += f"&targetAgentId={aid}"
    if a.thread:
        qs += f"&threadId={urllib.request.quote(a.thread)}"
    r = _req("GET", f"/api/intents?{qs}")
    if a.compact:
        for i in r.get("intents", []):
            sel = (
                f"L{i['selectionStart']}-{i['selectionEnd']}"
                if i.get("selectionStart")
                else ""
            )
            print(
                f"[{i['status']:8s}] {i['id']}  {i['fileId']} {sel}  "
                f"{(i.get('prompt') or '')[:60]}"
            )
    else:
        _pp(r)


def cmd_create_intent(a: argparse.Namespace) -> None:
    body: dict = {
        "projectId": a.project,
        "fileId": a.file,
        "prompt": a.prompt,
    }
    if a.agent:
        body["targetAgentId"] = a.agent
    if a.thread:
        body["threadId"] = a.thread
    if a.start is not None and a.end is not None:
        body["selectionStart"] = a.start
        body["selectionEnd"] = a.end
    if a.selection:
        body["selectionText"] = a.selection
    _pp(_req("POST", "/api/intents", body))


def cmd_claim_intent(a: argparse.Namespace) -> None:
    _pp(_req("PATCH", "/api/intents", {"id": a.id, "status": "claimed"}))


def cmd_answer_intent(a: argparse.Namespace) -> None:
    body: dict = {"id": a.id, "status": "answered"}
    if a.text:
        body["answerText"] = a.text
    if a.spec:
        # --spec accepts a JSON string or @path/to/file.json
        spec_text = _read_arg_or_file(a.spec)
        # Validate minimal shape
        try:
            obj = json.loads(spec_text)
            if not isinstance(obj, dict) or "root" not in obj or "elements" not in obj:
                raise SystemExit("--spec must be a json-render Spec ({root, elements:{…}})")
        except json.JSONDecodeError as e:
            raise SystemExit(f"--spec is not valid JSON: {e}")
        body["answerText"] = spec_text
    if a.edit:
        body["answerEditId"] = a.edit
    if not a.text and not a.edit and not a.spec:
        raise SystemExit("answer-intent needs --text and/or --edit and/or --spec")
    _pp(_req("PATCH", "/api/intents", body))


def _read_arg_or_file(v: str) -> str:
    """--xxx @file.json reads from file; otherwise return as-is."""
    if v.startswith("@"):
        with open(v[1:], "r", encoding="utf-8") as f:
            return f.read()
    return v


def cmd_close_intent(a: argparse.Namespace) -> None:
    _pp(_req("PATCH", "/api/intents", {"id": a.id, "status": "closed"}))


